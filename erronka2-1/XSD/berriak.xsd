<?xml version="1.0" encoding="UTF-8"?>
<!-- Albisteen XML fitxategiaren egitura balioztatzeko XSD-a -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="berriak">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="berria" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="id" type="xs:integer"/>
              <xs:element name="titulua" type="xs:string"/>
              <xs:element name="testua" type="xs:string"/>
              <xs:element name="irudia" type="xs:string"/>
              <xs:element name="kategoria" type="xs:string"/>
              <xs:element name="data" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
