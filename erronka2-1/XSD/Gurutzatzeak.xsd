<?xml version="1.0" encoding="UTF-8"?>
<!-- Cruces taula balioztatzeko XSD-a -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="cruces">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="enfrentamiento" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="equipo1" type="xs:string"/>
              <xs:element name="equipo2" type="xs:string"/>
              <xs:element name="goles1" type="xs:integer"/>
              <xs:element name="goles2" type="xs:integer"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
